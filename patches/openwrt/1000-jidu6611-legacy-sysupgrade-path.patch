From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Santhu195 <santhu195@users.noreply.github.com>
Date: Mon, 23 Nov 2026 18:30:00 +0530
Subject: [PATCH] qualcommbe: retain legacy JIDU6J11 sysupgrade identifier

The currently installed generic JIDU6J11 firmware identifies the board
as jiorouter,ax6000-jidu6j11. Use that identifier for the sysupgrade
archive and metadata while keeping the JIDU6611-specific device tree and
calibration data.

The new firmware must also use the legacy archive lookup on later
sysupgrades, because nand_do_upgrade expects a single sysupgrade
directory in the tar archive.

This alias is intentionally limited to JIDU6611.

---
 target/linux/qualcommbe/image/ipq95xx.mk                    | 2 ++
 target/linux/qualcommbe/ipq95xx/base-files/lib/upgrade/platform.sh | 5 +++++
 2 files changed, 7 insertions(+)

diff --git a/target/linux/qualcommbe/image/ipq95xx.mk b/target/linux/qualcommbe/image/ipq95xx.mk
--- a/target/linux/qualcommbe/image/ipq95xx.mk
+++ b/target/linux/qualcommbe/image/ipq95xx.mk
@@ -83,6 +83,8 @@ define Device/jiorouter_ax6000-jidu6611
 	$(call Device/jiorouter_ax6000-jidu6j11-common)
+	BOARD_NAME := jiorouter_ax6000-jidu6j11
+	SUPPORTED_DEVICES := jiorouter,ax6000-jidu6j11 jiorouter,ax6000-jidu6611
 	DEVICE_VARIANT := JIDU6611
 	DEVICE_DTS := ipq9554-jiorouter-ax6000-jidu6611
 endef
diff --git a/target/linux/qualcommbe/ipq95xx/base-files/lib/upgrade/platform.sh b/target/linux/qualcommbe/ipq95xx/base-files/lib/upgrade/platform.sh
--- a/target/linux/qualcommbe/ipq95xx/base-files/lib/upgrade/platform.sh
+++ b/target/linux/qualcommbe/ipq95xx/base-files/lib/upgrade/platform.sh
@@ -24,6 +24,11 @@ platform_check_image() {
 	case "$(board_name)" in
+	jiorouter,ax6000-jidu6611)
+		nand_do_platform_check "jiorouter,ax6000-jidu6j11" "$1"
+		return $?
+		;;
 	jiorouter,ax6000-jidu6111|\
 	jiorouter,ax6000-jidu6411|\
 	jiorouter,ax6000-jidu6611|\
--
2.43.0
