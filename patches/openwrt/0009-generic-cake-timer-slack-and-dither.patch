From 2617700000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenWrt CAKE selective backport integration
Subject: [PATCH] generic: import selected CAKE timer and dither optimisations

Import only #26177's shaper timer slack and per-tin quantum dither
patches. Deliberately exclude cake_mq fairness and PPP lockless transmit
changes pending separate compatibility and fairness evaluation.

---
diff --git a/target/linux/generic/pending-6.18/745-net-sched-sch_cake-give-the-shaper-timer-slack.patch b/target/linux/generic/pending-6.18/745-net-sched-sch_cake-give-the-shaper-timer-slack.patch
new file mode 100644
--- /dev/null
+++ b/target/linux/generic/pending-6.18/745-net-sched-sch_cake-give-the-shaper-timer-slack.patch
@@ -0,0 +1,76 @@
+From: Julius Bairaktaris <julius@bairaktaris.de>
+Subject: [PATCH] net/sched: sch_cake: give the shaper timer slack
+
+When the shaper holds the next packet back, CAKE arms its watchdog for
+the exact time that packet may leave. At a few hundred Mbit/s that is a
+timer interrupt, a softirq and a qdisc run for nearly every packet: on a
+4x Cortex-A53 router shaping 310 Mbit/s of download, the queue stopped
+on the shaper 1.29 times per packet sent.
+
+Let the timer fire up to four packet times late, capped at 100 us, as
+sch_fq does with its timer_slack. The shaper keeps its rate, since it
+sends what it owes once the timer runs. On the same router the shaper
+stops fell to 0.48 per packet and the CPU time per GB forwarded from
+14369 to 10481 ms (100 us slack, 8 flows, 4 runs each), at the same
+throughput. Four packet times are 156 us at 310 Mbit/s, where the cap
+applies, 48 us at 1 Gbit/s and 5 us at 10 Gbit/s.
+
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+---
+--- a/net/sched/sch_cake.c
++++ b/net/sched/sch_cake.c
+@@ -228,6 +228,7 @@ struct cake_sched_data {
+ 	/* time_next = time_this + ((len * rate_ns) >> rate_shft) */
+ 	ktime_t		time_next_packet;
+ 	ktime_t		failsafe_next_packet;
++	u64		timer_slack;
+ 	u64		rate_ns;
+ 	u16		rate_shft;
+ 	u16		overflow_timeout;
+@@ -1791,7 +1792,8 @@ static s32 cake_enqueue(struct sk_buff *
+ 					    ktime_to_ns(
+ 						   q->failsafe_next_packet));
+ 				sch->qstats.overlimits++;
+-				qdisc_watchdog_schedule_ns(&q->watchdog, next);
++				qdisc_watchdog_schedule_range_ns(&q->watchdog, next,
++								 q->timer_slack);
+ 			}
+ 		}
+ 	}
+@@ -2057,7 +2059,8 @@ begin:
+ 			       ktime_to_ns(q->failsafe_next_packet));
+ 
+ 		sch->qstats.overlimits++;
+-		qdisc_watchdog_schedule_ns(&q->watchdog, next);
++		qdisc_watchdog_schedule_range_ns(&q->watchdog, next,
++						 q->timer_slack);
+ 		return NULL;
+ 	}
+ 
+@@ -2265,7 +2268,8 @@ retry:
+ 		u64 next = min(ktime_to_ns(q->time_next_packet),
+ 			       ktime_to_ns(q->failsafe_next_packet));
+ 
+-		qdisc_watchdog_schedule_ns(&q->watchdog, next);
++		qdisc_watchdog_schedule_range_ns(&q->watchdog, next,
++						 q->timer_slack);
+ 	} else if (!sch->q.qlen) {
+ 		int i;
+ 
+@@ -2611,6 +2615,16 @@ static void cake_configure_rates(struct
+ 
+ 	qd->rate_ns   = qd->tins[ft].tin_rate_ns;
+ 	qd->rate_shft = qd->tins[ft].tin_rate_shft;
++
++	/* Waking the shaper for every packet costs a timer interrupt and a
++	 * softirq each. Letting the timer fire up to four packet times late
++	 * lets it send a few at once, as sch_fq's timer_slack does; the shaper
++	 * still meets its rate, since it catches up on what it owes. Capped so
++	 * that a slow link waits no longer than a fast one would.
++	 */
++	qd->timer_slack = min_t(u64, 100 * NSEC_PER_USEC,
++				(4ULL * psched_mtu(qdisc_dev(sch)) * qd->rate_ns) >>
++				qd->rate_shft);
+ }
+ 
+ static void cake_reconfigure(struct Qdisc *sch)

diff --git a/target/linux/generic/pending-6.18/746-net-sched-sch_cake-dither-the-flow-quantum-from-a-per-tin-generator.patch b/target/linux/generic/pending-6.18/746-net-sched-sch_cake-dither-the-flow-quantum-from-a-per-tin-generator.patch
new file mode 100644
--- /dev/null
+++ b/target/linux/generic/pending-6.18/746-net-sched-sch_cake-dither-the-flow-quantum-from-a-per-tin-generator.patch
@@ -0,0 +1,56 @@
+From: Julius Bairaktaris <julius@bairaktaris.de>
+Subject: [PATCH] net/sched: sch_cake: dither the flow quantum from a per-tin generator
+
+CAKE adds a random 16-bit value to every flow quantum it hands out, so
+that the scaled quantum does not accumulate a rounding error. That is
+one get_random_u16() for nearly every packet dequeued, and the
+dithering needs no more than a uniform value.
+
+Draw it from a prandom state in the tin instead, seeded from
+get_random_u64() when the qdisc is created. The tin is only touched
+under the qdisc lock, so the state needs no locking of its own.
+
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+---
+--- a/net/sched/sch_cake.c
++++ b/net/sched/sch_cake.c
+@@ -60,6 +60,7 @@
+ #include <linux/init.h>
+ #include <linux/skbuff.h>
+ #include <linux/jhash.h>
++#include <linux/prandom.h>
+ #include <linux/slab.h>
+ #include <linux/vmalloc.h>
+ #include <linux/reciprocal_div.h>
+@@ -160,6 +161,7 @@ struct cake_tin_data {
+ 	u16	overflow_idx[CAKE_QUEUES];
+ 	struct cake_host hosts[CAKE_QUEUES]; /* for triple isolation */
+ 	u16	flow_quantum;
++	struct rnd_state dither;
+ 
+ 	struct cobalt_params cparams;
+ 	u32	drop_overlimit;
+@@ -729,19 +731,20 @@ static u16 cake_get_flow_quantum(struct
+ 				 struct cake_flow *flow,
+ 				 int flow_mode)
+ {
+ 	u16 host_load = 1;
+ 
+ 	if (cake_dsrc(flow_mode))
+ 		host_load = max(host_load,
+ 				q->hosts[flow->srchost].srchost_bulk_flow_count);
+ 
+ 	if (cake_ddst(flow_mode))
+ 		host_load = max(host_load,
+ 				q->hosts[flow->dsthost].dsthost_bulk_flow_count);
+ 
+-	/* The get_random_u16() is a way to apply dithering to avoid
+-	 * accumulating roundoff errors
++	/* The random addend is a way to apply dithering to avoid
++	 * accumulating roundoff errors. It only has to be uniform, so it
++	 * comes from the tin's own generator rather than the system's.
+ 	 */
+ 	return (q->flow_quantum * quantum_div[host_load] +
+-		get_random_u16()) >> 16;
++		(u16)prandom_u32_state(&q->dither)) >> 16;
+ }
+@@ -3120,6 +3123,7 @@ static int cake_init(struct Qdisc *sch,
+ 		INIT_LIST_HEAD(&b->new_flows);
+ 		INIT_LIST_HEAD(&b->old_flows);
+ 		INIT_LIST_HEAD(&b->decaying_flows);
++		prandom_seed_state(&b->dither, get_random_u64());
+ 		b->sparse_flow_count = 0;
+ 		b->bulk_flow_count = 0;
+ 		b->decaying_flow_count = 0;
--
2.43.0
