From 2665500000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenWrt packet steering backport
Subject: [PATCH] netifd: reload packet steering when a WLAN interface is added

Keep the hardware-RSS behavior from upstream netifd PR #26222: when
receive interrupts already cover all CPUs, leave RPS disabled rather
than forcing another software-steering hop.

The JIDU-specific EDMA RXDESC child-IRQ discovery patch remains in
0005. Recalculate packet steering after a WLAN netdev is created after
boot so its IRQ topology is included.

Bump netifd PKG_RELEASE for both local netifd changes.

---
 package/network/config/netifd/Makefile                         |  2 +-
 package/network/config/netifd/files/etc/hotplug.d/net/20-packet-steering | 18 ++++++++++++++++++
 2 files changed, 19 insertions(+), 1 deletion(-)

diff --git a/package/network/config/netifd/Makefile b/package/network/config/netifd/Makefile
--- a/package/network/config/netifd/Makefile
+++ b/package/network/config/netifd/Makefile
@@ -1,7 +1,7 @@
 include $(TOPDIR)/rules.mk

 PKG_NAME:=netifd
-PKG_RELEASE:=1
+PKG_RELEASE:=3

 PKG_SOURCE_PROTO:=git
 PKG_SOURCE_URL=$(PROJECT_GIT)/project/netifd.git
diff --git a/package/network/config/netifd/files/etc/hotplug.d/net/20-packet-steering b/package/network/config/netifd/files/etc/hotplug.d/net/20-packet-steering
new file mode 100755
--- /dev/null
+++ b/package/network/config/netifd/files/etc/hotplug.d/net/20-packet-steering
@@ -0,0 +1,18 @@
+#!/bin/sh
+# A wireless interface made after boot has no receive packet steering until
+# the next interface event: apply it now. One run covers the interfaces a
+# radio brings up together.
+
+[ "$ACTION" = add ] && [ "$DEVTYPE" = wlan ] || exit 0
+[ -x /etc/init.d/packet_steering ] || exit 0
+/etc/init.d/packet_steering enabled || exit 0
+
+PENDING=/var/run/packet-steering.pending
+[ -e "$PENDING" ] && exit 0
+touch "$PENDING"
+
+(
+	sleep 3
+	rm -f "$PENDING"
+	/etc/init.d/packet_steering reload
+) &
--
2.43.0
