From 2222222222222222222222222222222222222222 Mon Sep 17 00:00:00 2001
From: Local OpenWrt integration <noreply@example.com>
Date: Tue, 24 Nov 2026 00:00:00 +0000
Subject: [PATCH] wifi: ath11k: stop TXQ rounds before the MSDU IDR fills

Track the number of in-flight MSDU IDs per TCL ring. A driver TXQ round
must check both TCL descriptor space and MSDU IDR capacity before
dequeueing a frame from mac80211. This avoids dequeuing and then dropping
a frame when the IDR is full.

Use one removal helper for every IDR removal so the counter remains
balanced through transmit failures, normal completions, firmware
releases, and firmware-recovery cleanup.

This is the IDR-capacity part of the ath11k airtime/TXQ v6 series.

---
 drivers/net/wireless/ath/ath11k/dp.c    |  1 +
 drivers/net/wireless/ath/ath11k/dp.h    |  6 +++++-
 drivers/net/wireless/ath/ath11k/dp_tx.c | 43 +++++++++++++++++++++++++++++++++++++++------
 drivers/net/wireless/ath/ath11k/dp_tx.h |  1 +
 drivers/net/wireless/ath/ath11k/mac.c   |  7 ++++---
 5 files changed, 48 insertions(+), 10 deletions(-)

--- a/drivers/net/wireless/ath/ath11k/dp.c
+++ b/drivers/net/wireless/ath/ath11k/dp.c
@@ -1089,5 +1089,6 @@ int ath11k_dp_alloc(struct ath11k_base *ab)
 	for (i = 0; i < ab->hw_params.hal_params->num_tx_rings; i++) {
 		idr_init(&dp->tx_ring[i].txbuf_idr);
+		atomic_set(&dp->tx_ring[i].num_txbuf, 0);
 		spin_lock_init(&dp->tx_ring[i].tx_idr_lock);
 		spin_lock_init(&dp->tx_ring[i].wake_tx_lock);
 		dp->tx_ring[i].tcl_data_ring_id = i;

--- a/drivers/net/wireless/ath/ath11k/dp.h
+++ b/drivers/net/wireless/ath/ath11k/dp.h
@@ -85,8 +85,12 @@ struct dp_tx_ring {
 	struct dp_srng tcl_data_ring;
 	struct dp_srng tcl_comp_ring;
 	struct idr txbuf_idr;
-	/* Protects txbuf_idr and num_pending */
+	/* Protects txbuf_idr; num_txbuf changes with it and is read without */
 	spinlock_t tx_idr_lock;
+	/* MSDU ids in use, one per frame between ath11k_dp_tx() and its
+	 * completion
+	 */
+	atomic_t num_txbuf;
 	/* Serializes wake_tx_queue operations for this ring */
 	spinlock_t wake_tx_lock;
 	struct hal_wbm_release_ring *tx_status;

--- a/drivers/net/wireless/ath/ath11k/dp_tx.c
+++ b/drivers/net/wireless/ath/ath11k/dp_tx.c
@@ -78,4 +78,33 @@ enum hal_encrypt_type ath11k_dp_tx_get_encrypt_type(u32 cipher)
 	default:
 		return HAL_ENCRYPT_TYPE_OPEN;
 	}
 }
+
+/* The caller holds tx_ring->tx_idr_lock. */
+static struct sk_buff *ath11k_dp_tx_idr_remove(struct dp_tx_ring *tx_ring,
+						       int msdu_id)
+{
+	struct sk_buff *msdu;
+
+	msdu = idr_remove(&tx_ring->txbuf_idr, msdu_id);
+	if (msdu)
+		atomic_dec(&tx_ring->num_txbuf);
+
+	return msdu;
+}
+
+/**
+ * ath11k_dp_tx_idr_has_room() - tell whether ath11k_dp_tx() can take a frame
+ * @tx_ring: the ring the frame would go to first
+ *
+ * ath11k_dp_tx() allocates the frame's MSDU id from the ring's idr, which
+ * holds DP_TX_IDR_SIZE - 1 ids and frees one when the frame completes. A
+ * caller that takes a frame from mac80211 only to have it refused for a full
+ * idr loses the frame, so it checks first.
+ *
+ * Return: true if the idr has an id free.
+ */
+bool ath11k_dp_tx_idr_has_room(struct dp_tx_ring *tx_ring)
+{
+	return atomic_read(&tx_ring->num_txbuf) < DP_TX_IDR_SIZE - 1;
+}

@@ -123,4 +152,6 @@ int ath11k_dp_tx(struct ath11k *ar, struct ath11k_vif *arvif,
 	spin_lock_bh(&tx_ring->tx_idr_lock);
 	ret = idr_alloc(&tx_ring->txbuf_idr, skb, 0,
 			DP_TX_IDR_SIZE - 1, GFP_ATOMIC);
+	if (likely(ret >= 0))
+		atomic_inc(&tx_ring->num_txbuf);
 	spin_unlock_bh(&tx_ring->tx_idr_lock);

@@ -276,4 +307,4 @@ fail_remove_idr:
 	spin_lock_bh(&tx_ring->tx_idr_lock);
-	idr_remove(&tx_ring->txbuf_idr,
-		   FIELD_GET(DP_TX_DESC_ID_MSDU_ID, ti.desc_id));
+	ath11k_dp_tx_idr_remove(tx_ring,
+				FIELD_GET(DP_TX_DESC_ID_MSDU_ID, ti.desc_id));
 	spin_unlock_bh(&tx_ring->tx_idr_lock);

@@ -295,3 +326,3 @@ static void ath11k_dp_tx_free_txbuf(struct ath11k_base *ab, u8 mac_id,
 	spin_lock(&tx_ring->tx_idr_lock);
-	msdu = idr_remove(&tx_ring->txbuf_idr, msdu_id);
+	msdu = ath11k_dp_tx_idr_remove(tx_ring, msdu_id);
 	spin_unlock(&tx_ring->tx_idr_lock);

@@ -338,3 +369,3 @@ void ath11k_dp_tx_free_pending(struct ath11k_base *ab)
 	idr_for_each_entry(&tx_ring->txbuf_idr, msdu, msdu_id) {
-		idr_remove(&tx_ring->txbuf_idr, msdu_id);
+		ath11k_dp_tx_idr_remove(tx_ring, msdu_id);
 		__skb_queue_tail(&pending, msdu);

@@ -366,3 +397,3 @@ static void ath11k_dp_tx_htt_tx_complete_buf(struct ath11k_base *ab,
 	spin_lock(&tx_ring->tx_idr_lock);
-	msdu = idr_remove(&tx_ring->txbuf_idr, ts->msdu_id);
+	msdu = ath11k_dp_tx_idr_remove(tx_ring, ts->msdu_id);
 	spin_unlock(&tx_ring->tx_idr_lock);

@@ -795,3 +826,3 @@ void ath11k_dp_tx_completion_handler(struct ath11k_base *ab, int ring_id)
 		spin_lock(&tx_ring->tx_idr_lock);
-		msdu = idr_remove(&tx_ring->txbuf_idr, msdu_id);
+		msdu = ath11k_dp_tx_idr_remove(tx_ring, msdu_id);
 		if (unlikely(!msdu)) {

--- a/drivers/net/wireless/ath/ath11k/dp_tx.h
+++ b/drivers/net/wireless/ath/ath11k/dp_tx.h
@@ -23,2 +23,3 @@ int ath11k_dp_tx(struct ath11k *ar, struct ath11k_vif *arvif,
 		 struct ath11k_sta *arsta, struct sk_buff *skb);
+bool ath11k_dp_tx_idr_has_room(struct dp_tx_ring *tx_ring);
 void ath11k_dp_tx_completion_handler(struct ath11k_base *ab, int ring_id);

--- a/drivers/net/wireless/ath/ath11k/mac.c
+++ b/drivers/net/wireless/ath/ath11k/mac.c
@@ -10103,5 +10103,6 @@ static int ath11k_mac_tx_push_txq(struct ath11k *ar, struct ieee80211_txq *txq)
 	/* ieee80211_tx_dequeue() applies the airtime queue limit, so a
 	 * selection ends where that limit binds or the queue empties. A full
-	 * TCL ring ends the whole round, and so does a frame the hardware
-	 * refuses, as long as a frame in flight will restart it.
+	 * TCL ring or MSDU IDR ends the round before a frame is taken from
+	 * the queue, and so does a frame the hardware refuses anyway, as
+	 * long as a frame in flight will restart it.
 	 */

@@ -10149,4 +10149,4 @@ static int ath11k_mac_tx_push_txq(struct ath11k *ar, struct ieee80211_txq *txq)
-		if (num_free == 0) {
+		if (num_free == 0 || !ath11k_dp_tx_idr_has_room(tx_ring)) {
 			spin_unlock_bh(&tx_ring->wake_tx_lock);
 			if (ath11k_mac_mark_txq_starved(ar, txq->ac))
 				return -ENOSPC;
--
2.43.0
